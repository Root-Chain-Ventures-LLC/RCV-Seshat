{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Seshat chart values",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "port": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "secretRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {"type": "string"},
        "key": {"type": "string", "minLength": 1}
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string"},
        "annotations": {"type": "object"},
        "tls": {"type": "array", "items": {"type": "object", "required": ["secretName"], "properties": {"secretName": {"type": "string", "minLength": 1}, "hosts": {"type": "array", "items": {"type": "string"}}}}},
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["host", "paths"],
            "properties": {
              "host": {"type": "string", "minLength": 1},
              "paths": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path"], "properties": {"path": {"type": "string"}, "pathType": {"enum": ["Prefix", "Exact", "ImplementationSpecific"]}}}}
            }
          }
        }
      }
    }
  },
  "properties": {
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "digest": {"type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "imagePullSecrets": {"type": "array"},
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {"type": "string"},
        "secretKeyKey": {"type": "string", "minLength": 1}
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["external", "cnpg", "none"]},
        "maxConns": {"type": "integer", "minimum": 0},
        "external": {"$ref": "#/definitions/secretRef"},
        "cnpg": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "clusterName": {"type": "string", "minLength": 1},
            "secretName": {"type": "string"},
            "key": {"type": "string", "minLength": 1}
          }
        },
        "allowReplicatedSqlite": {"type": "boolean"}
      }
    },
    "migrate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "backoffLimit": {"type": "integer", "minimum": 0},
        "activeDeadlineSeconds": {"type": "integer", "minimum": 30}
      }
    },
    "roles": {"type": "object", "additionalProperties": false, "properties": {"split": {"type": "boolean"}}},
    "replicaCount": {"type": "integer", "minimum": 1},
    "console": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"replicaCount": {"type": "integer", "minimum": 1}, "resources": {"type": "object"}}
    },
    "logLevel": {"enum": ["trace", "debug", "info", "warn", "error"]},
    "leaderElection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["auto", "postgres", "k8s-lease"]},
        "leaseName": {"type": "string", "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$"}
      }
    },
    "queue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"bus": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "existingSecret": {"type": "string"}, "key": {"type": "string"}, "mode": {"enum": ["", "off", "hybrid", "only"]}}}}
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "size": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|Pi|Ei|k|M|G|T|P|E)?$"},
        "storageClass": {"type": "string"},
        "accessModes": {"type": "array", "items": {"enum": ["ReadWriteOnce", "ReadWriteOncePod", "ReadWriteMany", "ReadOnlyMany"]}, "minItems": 1},
        "retentionWhenDeleted": {"enum": ["Retain", "Delete"]},
        "retentionWhenScaled": {"enum": ["Retain", "Delete"]}
      }
    },
    "intake": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "type": {"enum": ["LoadBalancer", "NodePort", "ClusterIP"]},
            "externalTrafficPolicy": {"enum": ["Local", "Cluster"]},
            "loadBalancerIP": {"type": "string"},
            "loadBalancerClass": {"type": "string"},
            "loadBalancerSourceRanges": {"type": "array", "items": {"type": "string"}},
            "healthCheckNodePort": {"type": ["integer", "null"], "minimum": 1, "maximum": 65535},
            "split": {"type": "boolean"},
            "annotations": {"type": "object"}
          }
        },
        "ports": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "snmpTrap": {"$ref": "#/definitions/port"},
            "syslogUDP": {"$ref": "#/definitions/port"},
            "syslogTCP": {"$ref": "#/definitions/port"},
            "syslogTLS": {"$ref": "#/definitions/port"},
            "netflow": {"$ref": "#/definitions/port"},
            "ipfix": {"$ref": "#/definitions/port"},
            "sflow": {"$ref": "#/definitions/port"},
            "telemetryDialout": {"$ref": "#/definitions/port"}
          }
        },
        "syslogTLS": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"existingSecret": {"type": "string"}, "clientCA": {"type": "boolean"}}
        },
        "hostNetwork": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"enabled": {"type": "boolean"}, "standardPorts": {"type": "boolean"}}
        },
        "sourceIPCheck": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "snatCIDRs": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-fA-F:.]+(/[0-9]{1,3})?$"}}
          }
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "containerPort": {"type": "integer", "minimum": 1, "maximum": 65535},
        "cookieSecure": {"enum": ["auto", "always", "never"]},
        "publicURL": {"type": "string", "pattern": "^(https?://.+)?$"},
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"type": {"enum": ["ClusterIP", "NodePort", "LoadBalancer"]}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}, "annotations": {"type": "object"}}
        },
        "ingress": {"$ref": "#/definitions/ingress"}
      }
    },
    "nms": {"type": "object", "additionalProperties": false, "properties": {"preserveSource": {"type": "boolean"}}},
    "tracker": {"type": "object", "additionalProperties": false, "properties": {"shardByOrdinal": {"type": "boolean"}}},
    "portal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "mode": {"enum": ["shared", "push", "api", "db"]},
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "tag": {"type": "string"},
            "digest": {"type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$"},
            "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
          }
        },
        "replicaCount": {"type": "integer", "minimum": 1},
        "publicURL": {"type": "string", "pattern": "^(https?://.+)?$"},
        "secrets": {"type": "object", "additionalProperties": false, "properties": {"existingSecret": {"type": "string"}}},
        "readOnlyDatabase": {"$ref": "#/definitions/secretRef"},
        "database": {"$ref": "#/definitions/secretRef"},
        "api": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"url": {"type": "string", "pattern": "^(https?://.+)?$"}, "existingSecret": {"type": "string"}, "key": {"type": "string"}}
        },
        "sync": {"$ref": "#/definitions/secretRef"},
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"enabled": {"type": "boolean"}, "size": {"type": "string"}, "storageClass": {"type": "string"}}
        },
        "ingress": {"$ref": "#/definitions/ingress"},
        "resources": {"type": "object"},
        "extraEnv": {"type": "array"},
        "extraEnvFrom": {"type": "array"}
      }
    },
    "drain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeoutSeconds": {"type": "integer", "minimum": 0, "maximum": 600},
        "holdSeconds": {"type": "integer", "minimum": 0, "maximum": 300}
      }
    },
    "terminationGracePeriodSeconds": {"type": "integer", "minimum": 1},
    "pdb": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "maxUnavailable": {"type": ["integer", "string"]},
        "minAvailable": {"type": ["integer", "string", "null"]}
      }
    },
    "topologySpread": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "maxSkew": {"type": "integer", "minimum": 1},
        "topologyKey": {"type": "string", "minLength": 1},
        "whenUnsatisfiable": {"enum": ["DoNotSchedule", "ScheduleAnyway"]}
      }
    },
    "resources": {"type": "object"},
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"create": {"type": "boolean"}, "name": {"type": "string"}, "annotations": {"type": "object"}}
    },
    "podAnnotations": {"type": "object"},
    "priorityClassName": {"type": "string"},
    "nodeSelector": {"type": "object"},
    "tolerations": {"type": "array"},
    "affinity": {"type": "object"},
    "extraEnv": {"type": "array"},
    "extraEnvFrom": {"type": "array"},
    "extraVolumes": {"type": "array"},
    "extraVolumeMounts": {"type": "array"},
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"enabled": {"type": "boolean"}, "interval": {"type": "string"}, "scrapeTimeout": {"type": "string"}, "labels": {"type": "object"}, "tokenSecret": {"type": "object", "properties": {"name": {"type": "string"}, "key": {"type": "string"}}}}
        }
      }
    }
  }
}
