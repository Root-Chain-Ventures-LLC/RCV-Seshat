# Seshat edge collector (docs/edge.md), as installed by the seshat-edge .deb/.rpm
# (docs/packaging.md). By hand: install the binary as /usr/bin/seshat-edge, copy this file to
# /etc/systemd/system/ and create /etc/seshat/edge.env (deploy/edge/README.md), then:
#   systemctl daemon-reload && systemctl enable --now seshat-edge
[Unit]
Description=Seshat edge collector
Documentation=https://github.com/Root-Chain-Ventures-LLC/RCV-Seshat/blob/main/docs/edge.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/seshat-edge --role edge
# SESHAT_EDGE_SERVER / SESHAT_EDGE_ENROL_TOKEN for the first start, SESHAT_EDGE_CA_FILE for a private CA.
# /etc/seshat-edge/edge.env is the location used before the packages existed; still read, the
# packaged /etc/seshat/edge.env wins where both set a variable.
EnvironmentFile=-/etc/seshat-edge/edge.env
EnvironmentFile=-/etc/seshat/edge.env
Environment=SESHAT_ROLE=edge
Environment=SESHAT_DATA_DIR=/var/lib/seshat-edge
# Traps and syslog on their standard ports; the packs are the ones the server distributes, this is the fallback.
Environment=SESHAT_PACKS_DIR=/usr/share/seshat-edge/packs
Environment=SESHAT_SNMP_TRAP_LISTEN=:162
Environment=SESHAT_SYSLOG_UDP_LISTEN=:514
Environment=SESHAT_SYSLOG_TCP_LISTEN=:514
Restart=always
RestartSec=5
LimitNOFILE=65536
TimeoutStopSec=30

# Run as a transient unprivileged user; the only privilege kept is binding ports below 1024.
DynamicUser=yes
StateDirectory=seshat-edge
StateDirectoryMode=0700
UMask=0077
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# The file system is read-only except the state directory (state file, queues, packs, KB snapshot).
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
