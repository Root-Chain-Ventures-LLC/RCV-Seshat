# /etc/seshat/edge.env: settings for the seshat-edge service (docs/edge.md, deploy/edge/README.md).
# Read by systemd as root, so it can stay mode 0600. Installed once and never overwritten by an upgrade.
#
# First start only: the server URL and the one-time enrolment token from the server's Edges page.
# Remove both lines once the edge has enrolled (the identity is in /var/lib/seshat-edge/edge.json).
# SESHAT_EDGE_SERVER=https://seshat.example.com
# SESHAT_EDGE_ENROL_TOKEN=sht_enr_REPLACE_ME
# The server certificate comes from a private CA:
# SESHAT_EDGE_CA_FILE=/etc/seshat/server-ca.pem
#
# Already set by the unit (a line here overrides it): SESHAT_DATA_DIR=/var/lib/seshat-edge,
# SESHAT_PACKS_DIR=/usr/share/seshat-edge/packs, traps on :162 and syslog on :514.
#
# Edge group with a shared receiving address (VRRP; docs/edge.md): the most the server may make this edge hold,
# CIDRs or addresses, comma separated, or "none" to forbid VRRP on this edge. Set it: without one the edge follows the
# server's configuration alone. VRRP also needs the drop-in /usr/share/seshat-edge/systemd/drop-ins/edge-vrrp.conf.
# SESHAT_EDGE_VRRP_CEILING=192.0.2.0/24
# SESHAT_EDGE_VRRP_CEILING_FILE=/etc/seshat/vrrp-ceiling.txt
