# /etc/seshat/device-tracker.env: settings for the seshat-device-tracker service (the SSO lookup
# portal, docs/device-tracker-portal.md). Read by systemd as root, so it can stay mode 0600. Installed
# once and never overwritten by an upgrade. After a change: systemctl restart seshat-device-tracker
#
# Already set by the unit (a line here overrides it):
#   SESHAT_DATA_DIR=/var/lib/seshat-device-tracker   SESHAT_LISTEN=:8081   SESHAT_PORTAL_MODE=push

# Secret key: the package generated the portal's OWN key into /etc/seshat/device-tracker-secret.env (root-only);
# the portal runs as its own user and never reads the gateway's key file. In mode "shared" the portal must use
# the same key as Seshat: set it here (this file is root-only, 0600), or point SESHAT_SECRET_KEY_FILE at a
# file the user seshat-tracker can read (mode 0600). At least 32 bytes: openssl rand -base64 48
# SESHAT_SECRET_KEY=
# SESHAT_SECRET_KEY_FILE=

# How the portal gets its data: push (Seshat sends changes here), api, db or shared.
# SESHAT_PORTAL_MODE=push
# SESHAT_PORTAL_SYNC_TOKEN=             # mode push: at least 32 random characters, also set on the Seshat side
# SESHAT_PORTAL_API_URL=https://seshat.example.com
# SESHAT_PORTAL_API_TOKEN=
# SESHAT_PORTAL_DB_URL=postgres://tracker_portal:CHANGE_ME@db.example.com:5432/seshat?sslmode=verify-full
# SESHAT_DATABASE_URL=                  # mode shared: the same URL Seshat uses

# Break-glass administrator, created on the first start when the portal has no users.
# SESHAT_PORTAL_ADMIN_EMAIL=breakglass@example.com
# SESHAT_PORTAL_ADMIN_PASSWORD=

# Single sign-on (or Settings > Sign-in in the UI).
# SESHAT_PUBLIC_URL=https://tracker.example.com
# SESHAT_OIDC_ENABLED=true
# SESHAT_OIDC_ISSUER=https://idp.example.com
# SESHAT_OIDC_CLIENT_ID=
# SESHAT_OIDC_CLIENT_SECRET=
# SESHAT_TRUSTED_PROXIES=192.0.2.10   # the reverse proxy in front (docs/security.md)
