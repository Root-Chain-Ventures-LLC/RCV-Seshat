# /etc/seshat/seshat.env: settings for the seshat service (systemd reads this file as root before
# starting the process, so it can stay mode 0600). Installed once by the package and never overwritten:
# an upgrade leaves your copy alone and ships the new example as seshat.env.dpkg-dist / .rpmnew.
# Every variable is documented in .env.example in the source tree and in docs/; the most common ones
# are below. After a change: systemctl restart seshat
#
# Already set by the unit (a line here overrides it):
#   SESHAT_DATA_DIR=/var/lib/seshat   SESHAT_PACKS_DIR=/usr/share/seshat/packs   SESHAT_LISTEN=:8080
#   SESHAT_SNMP_TRAP_LISTEN=:162      SESHAT_SYSLOG_UDP_LISTEN=:514             SESHAT_SYSLOG_TCP_LISTEN=:514

# Secret key: the package generated one into /etc/seshat/secret.env (root-only, 0600). To use your own (every
# node of a cluster needs the SAME key), set it here; it then overrides the generated one. At least 32 bytes:
# openssl rand -base64 48. Or SESHAT_SECRET_KEY_FILE=/path (mode 0600/0400, owned by the user seshat), which wins.
# Changing it makes stored destination credentials and SNMPv3 keys unreadable (re-seal them with
# `seshat secrets rekey`). Back the key up separately from /var/lib/seshat.
# SESHAT_SECRET_KEY=

# Storage: empty = SQLite under /var/lib/seshat. PostgreSQL for clusters (docs/storage.md).
# SESHAT_DATABASE_URL=postgres://seshat_app:CHANGE_ME@db.example.com:5432/seshat?sslmode=verify-full

# The UI and API speak plain HTTP on :8080 (the unit default): put a TLS reverse proxy in front of it
# (docs/hardening.md). With the proxy on the same host, bind to loopback:
# SESHAT_LISTEN=127.0.0.1:8080
# Behind a reverse proxy that terminates TLS: list its address(es) so its X-Forwarded-* headers are
# believed (docs/security.md). Nobody is trusted by default.
# SESHAT_TRUSTED_PROXIES=192.0.2.10
# First-run setup token (at least 32 characters). Empty: a random one is written to the journal at start
# (journalctl -u seshat | grep setup_token) and is needed in the setup page.
# SESHAT_SETUP_TOKEN=
# Bearer token for Prometheus scraping /metrics (at least 32 characters).
# SESHAT_METRICS_TOKEN=
# SESHAT_PUBLIC_URL=https://seshat.example.com

# SESHAT_LOG_LEVEL=info
# SESHAT_ROLE=all                       # all | collector | console | poller (docs/ha.md); edges use the seshat-edge package

# Syslog over TLS (RFC 5425), off when empty. The key must be readable by the seshat user.
# SESHAT_SYSLOG_TLS_LISTEN=:6514
# SESHAT_SYSLOG_TLS_CERT=/etc/seshat/tls/syslog.pem
# SESHAT_SYSLOG_TLS_KEY=/etc/seshat/tls/syslog.key

# Flows (UDP): NetFlow v5/v9, IPFIX, sFlow.
# SESHAT_FLOW_NETFLOW_LISTEN=:2055
# SESHAT_FLOW_IPFIX_LISTEN=:4739
# SESHAT_FLOW_SFLOW_LISTEN=:6343

# High availability (docs/ha.md). VRRP and anycast also need a drop-in from
# /usr/share/seshat/systemd/drop-ins/ for their capabilities.
# SESHAT_NODE_NAME=node-a
# SESHAT_CLUSTER_SECRET=
# SESHAT_CLUSTER_PEERS=https://node-b.example.com:8080
# SESHAT_DRAIN_GRACE=3s                 # keep TimeoutStopSec in the unit above GRACE + TIMEOUT
# SESHAT_DRAIN_TIMEOUT=20s
