# Copy to .env and edit. .env is never committed.

# The secret key seals every stored credential (destination passwords and tokens, SNMPv3 keys, the edge CA key).
# REQUIRED. At least 32 bytes of random data; generate one with:  openssl rand -base64 48
# Back it up SEPARATELY from the data: lose it and the stored credentials are gone; store it with the database
# backup and the sealing protects nothing. docs/hardening.md section 4.
SESHAT_SECRET_KEY=
# Or keep it out of the environment: a file (mode 0600/0400, owned by the service user), read once at start.
# With Docker use compose.keyfile.yaml. If both are set the file wins and a warning is logged.
# SESHAT_SECRET_KEY_FILE=/run/secrets/seshat_secret_key

# DEVELOPMENT MODE, evaluation only: generates a key INTO the data volume (next to the data it protects), enables
# profiling endpoints on an edge, and logs a warning on every start. Never set this in production; leave it commented.
# SESHAT_DEV=1

# docker compose publishes the UI/API (plain HTTP) and the portal on the loopback interface only. Put a TLS reverse
# proxy in front (docs/hardening.md section 3), or publish on one private address:
# SESHAT_BIND=127.0.0.1
# SESHAT_PORTAL_BIND=127.0.0.1

# Operator-set outbound URLs (tracker API sources, connectors, destinations) may not target loopback, link-local or
# cloud-metadata addresses unless this is 1 (private RFC 1918 targets are always allowed).
# SESHAT_ALLOW_LOCAL_TARGETS=0

# Storage. Empty = SQLite in the data volume. A postgres:// URL = PostgreSQL.
# SESHAT_DATABASE_URL=postgres://seshat:CHANGE_ME@postgres:5432/seshat?sslmode=disable
# Used by compose.postgres.yaml (letters and digits only; generate with: openssl rand -hex 16). Do not keep CHANGE_ME.
# SESHAT_POSTGRES_PASSWORD=
# Production: a least-privilege role and verified TLS, see docs/storage.md and deploy/postgres/:
# SESHAT_DATABASE_URL=postgres://seshat_app:CHANGE_ME@db.example.com:5432/seshat?sslmode=verify-full&sslrootcert=/data/tls/db-ca.pem
# The URL must reach PostgreSQL directly (or through PgBouncer in SESSION pooling mode): change
# notifications use LISTEN/NOTIFY on one dedicated connection, which PgBouncer transaction pooling breaks.

# Cluster (replicas sharing one PostgreSQL). See docs/storage.md.
# This replica's name in /api/cluster/leader and the seshat_cluster_leader metric. Default: the hostname.
# SESHAT_INSTANCE=seshat-1
# on (default): LISTEN/NOTIFY with a 2 s polling fallback. off: poll only (use when LISTEN cannot work).
# SESHAT_STORE_LISTEN=on
# While PostgreSQL is unreachable the replica serves from memory and buffers writes; this is the
# journal capacity (oldest dropped and counted when full, replayed in order on reconnect).
# SESHAT_STORE_OFFLINE_JOURNAL_MAX=10000
# /api/ready status while degraded: 200 (default, keep receiving traffic) or 503 (let a load balancer drain it).
# SESHAT_STORE_DEGRADED_STATUS=200

# HTTP listener inside the container, process role, log level.
# SESHAT_LISTEN=:8080
# SESHAT_ROLE=all
# SESHAT_LOG_LEVEL=info

# Session cookie Secure attribute: auto (when the request is HTTPS or the proxy says so), always, never.
# SESHAT_COOKIE_SECURE=auto
# Reverse proxies whose X-Forwarded-For / X-Forwarded-Proto are believed (addresses or CIDRs, comma
# separated). Empty = nobody: the client is the TCP peer. Set this when a proxy fronts Seshat, or every
# client shares the proxy's address. docs/security.md.
# SESHAT_TRUSTED_PROXIES=192.0.2.10,198.51.100.0/24
# DEPRECATED: =1 trusts one hop (the right-most X-Forwarded-For entry) from any private or loopback peer and
# logs a warning; a client that can reach Seshat directly from a private network can still spoof its address.
# Use the list. Prefixes shorter than /8 (IPv4) or /32 (IPv6) are refused.
# SESHAT_TRUST_PROXY=0
# External URL of this install (SSO callback and logout-return addresses are built from it).
# SESHAT_PUBLIC_URL=https://seshat.example.com

# First-run setup: the call that creates the first administrator needs this token (at least 32 characters,
# e.g. openssl rand -hex 32). Empty = a random one-time token is generated at start and written to the log
# (docker compose logs seshat | grep setup_token). Set it when running several replicas.
# SESHAT_SETUP_TOKEN=
# Let a plain request from the machine itself skip a GENERATED token (not safe with a same-host reverse proxy).
# SESHAT_SETUP_ALLOW_LOOPBACK=0

# Bearer token Prometheus presents to /metrics (at least 32 characters). Without it /metrics needs an
# administrator or operator session or API token. See docs/security.md for the scrape config.
# SESHAT_METRICS_TOKEN=

# Session lifetimes: absolute (password), absolute (single sign-on), and idle (0s = no idle limit).
# SESHAT_SESSION_TTL=24h
# SESHAT_SSO_SESSION_TTL=8h
# SESHAT_SESSION_IDLE_TIMEOUT=2h     # 0s for an unattended wallboard / NOC display

# SNMP trap listener (UDP). compose.yaml publishes it as host port 162.
# SESHAT_SNMP_TRAP_LISTEN=:1162
# This listener's SNMPv3 engine ID in hex (5 to 32 octets). Empty = generated once and kept in the database.
# SESHAT_SNMP_ENGINE_ID=
# Vendor packs (the MIB library compiles <dir>/<pack>/mibs). The image ships the built-in packs at /packs.
# Operator-uploaded MIBs live in <data dir>/mibs.
# SESHAT_PACKS_DIR=/packs
# Debugging aid: append every event to this file as one JSON line.
# SESHAT_DEBUG_NDJSON_PATH=

# Device knowledge base (see docs/device-kb.md). Defaults shown; leave commented to keep them.
# SESHAT_KB_UNKNOWN_CAP=50000     # most unknown devices kept (least recently seen evicted first)
# SESHAT_KB_UNKNOWN_TTL=24h       # an unknown device unseen this long is forgotten
# SESHAT_KB_REFRESH=24h           # known facts go stale (and are refreshed in the background) after this
# SESHAT_KB_CREATE_RATE=200       # new unknown devices per second per site/VRF (spoof protection)
# SESHAT_KB_WORKERS=4             # background learning workers
# SESHAT_KB_LEARN_QUEUE=10000     # bounded learn queue length
# Opt-in active SNMP polling limits (docs/device-kb.md#where-polling-is-allowed-to-go). Which addresses
# may be polled is set per profile under Settings, Connectors (default: private address space only).
# SESHAT_KB_POLL_RATE=20          # polls started per second, all targets together
# SESHAT_KB_POLL_BURST=40         # burst allowance of that limit
# SESHAT_KB_POLL_INTERVAL=5m      # least time between two polls of one address
# SESHAT_KB_POLL_ALLOW_LOOPBACK=0 # 1 lets 127.0.0.0/8 be polled: demos and simulators on one machine only
# SESHAT_KB_POLL_MAX_BACKOFF=6h   # the wait doubles after each failed poll of an address, up to this

# Device Tracker (docs/device-tracker.md). Nothing is polled until an operator enables a device.
# SESHAT_TRACKER_POLL=1           # 0 turns the SNMP pollers off on this instance (sightings from events stay on)
# SESHAT_TRACKER_WORKERS=4        # concurrent device polls
# SESHAT_TRACKER_RATE=50          # SNMP requests per second per device
# Per-sender bounds on tracker sightings taken from syslog/trap/flow events (a sender over a bound
# is dropped and counted, never blocked): observations per second, bucket depth, and distinct new
# MAC addresses per hour. 0 / unset takes the default.
# SESHAT_TRACKER_SIGHTING_RATE=1000
# SESHAT_TRACKER_SIGHTING_BURST=5000
# SESHAT_TRACKER_SIGHTING_MACS_PER_HOUR=50000
# SESHAT_TRACKER_SHARD=0/2        # spread pollers over replicas: poll only devices whose hash modulo 2 is 0
# Outputs. Each destination keeps a disk queue under $SESHAT_DATA_DIR/queue/<destination>/ (plan for the
# sum of the per-destination limits, 1 GiB each by default; see docs/outputs.md).
# File destinations may only write below this directory. Empty = <data dir>/output.
# SESHAT_OUTPUT_DIR=
# Destination credentials are stored encrypted in the database under SESHAT_SECRET_KEY; changing that key
# makes them unreadable. The tests that talk to real Logstash, Elasticsearch/OpenSearch, Kafka, Splunk or
# syslog read SESHAT_IT_* variables (see docs/outputs.md) and are never run by default.

# Build identity, shown to signed-in admins at /api/version. Set by your build pipeline.
# SESHAT_VERSION empty = the version the binary was built as.
# SESHAT_VERSION=
# SESHAT_COMMIT=
# SESHAT_BUILT_AT=
# Image to run. The default is the published image of the version you downloaded.
# SESHAT_IMAGE=ghcr.io/root-chain-ventures-llc/seshat:0.2.0
# SESHAT_PORTAL_IMAGE=ghcr.io/root-chain-ventures-llc/seshat-device-tracker:0.2.0

# ---- Syslog input (docs/inputs/syslog.md) ----
# Listen addresses inside the container; compose maps host 514 to 1514. "off" disables a listener.
# SESHAT_SYSLOG_UDP_LISTEN=:1514
# SESHAT_SYSLOG_TCP_LISTEN=:1514
# Syslog over TLS (RFC 5425), empty = off. Needs a certificate and key (PEM) readable by the container.
# SESHAT_SYSLOG_TLS_LISTEN=:6514
# SESHAT_SYSLOG_TLS_CERT=/data/tls/syslog.pem
# SESHAT_SYSLOG_TLS_KEY=/data/tls/syslog.key
# Require devices to present a certificate signed by this CA (PEM bundle):
# SESHAT_SYSLOG_TLS_CLIENT_CA=/data/tls/clients-ca.pem
# SESHAT_SYSLOG_TLS_REQUIRE_CLIENT_CERT=0
# Zone for RFC 3164 timestamps, which carry none: an IANA name (Europe/Berlin) or an offset (+02:00).
# Default UTC. Applies to devices that send local time without a zone.
# SESHAT_SYSLOG_ASSUME_TZ=UTC
# ---- Flow input (docs/inputs/flows.md) ----
# UDP listen addresses; "off" disables one. Every socket decodes NetFlow v5/v9, IPFIX and sFlow v5 by the
# version in the datagram, so the three ports are a convention, not a restriction.
# SESHAT_FLOW_NETFLOW_LISTEN=:2055
# SESHAT_FLOW_IPFIX_LISTEN=:4739
# SESHAT_FLOW_SFLOW_LISTEN=:6343
# Optional GeoIP / ASN enrichment from MaxMind-format databases YOU supply (nothing is bundled); a file that
# changes on disk is reloaded within 30 s. Fills source.geo.*, source.as.* and destination.* likewise.
# SESHAT_GEOIP_CITY_DB=/data/geoip/city.mmdb
# SESHAT_GEOIP_ASN_DB=/data/geoip/asn.mmdb
# ---- Streaming telemetry (docs/inputs/telemetry.md) ----
# gRPC dial-out listener for Cisco MDT, Juniper and gNMI dial-out; "off" disables. gNMI/JTI dial-in targets and their
# subscriptions are configured in the UI (Inputs > Telemetry), not here.
# SESHAT_TELEMETRY_GNMI_DIALOUT_LISTEN=:57400
# Serve the dial-out listener over TLS; with a client CA, devices must present a certificate that chains to it.
# SESHAT_TELEMETRY_TLS_CERT=/data/tls/telemetry.pem
# SESHAT_TELEMETRY_TLS_KEY=/data/tls/telemetry.key
# SESHAT_TELEMETRY_TLS_CLIENT_CA=/data/tls/telemetry-clients-ca.pem
# Dial-out limits (0 or unset = default): largest gRPC message in MiB (4), concurrent streams per connection (100) and per source address (256),
# connections in total (2000) and per source address (32), idle-connection timeout in seconds (300) and the bytes all
# MDT streams may hold in incomplete chunked messages in MiB (64). Without TLS the listener is plaintext and
# unauthenticated: a warning is logged when it is bound to a non-loopback address.
# SESHAT_TELEMETRY_MAX_RECV_MIB=4
# SESHAT_TELEMETRY_MAX_STREAMS=100
# SESHAT_TELEMETRY_MAX_STREAMS_PER_SOURCE=256
# SESHAT_TELEMETRY_MAX_CONNECTIONS=2000
# SESHAT_TELEMETRY_MAX_CONNECTIONS_PER_SOURCE=32
# SESHAT_TELEMETRY_IDLE_TIMEOUT_SECONDS=300
# SESHAT_TELEMETRY_REASSEMBLY_BUDGET_MIB=64
# Vendor packs directory (the image ships /packs; development defaults to ./packs).
# SESHAT_PACKS_DIR=/packs

# ---- Device Tracker portal (docs/device-tracker-portal.md) ----
# Data mode of the portal: push (default), api, db, shared. Validated at start.
# SESHAT_PORTAL_MODE=push
# mode api: Seshat's address and an API token of role user (Settings > API tokens in Seshat).
# SESHAT_PORTAL_API_URL=https://seshat.example.com
# SESHAT_PORTAL_API_TOKEN=
# mode db: read-only role over the tracker_public views (deploy/postgres/tracker_public_role.sql). mode shared: optional.
# SESHAT_PORTAL_DB_URL=postgres://tracker_portal:CHANGE_ME@db.example.com:5432/seshat?sslmode=verify-full
# mode push: static pre-shared token a sender may present (or create "sync" tokens in the UI); mTLS needs the TLS settings.
# At least 32 characters (openssl rand -hex 32); a shorter value stops the portal at start.
# SESHAT_PORTAL_SYNC_TOKEN=
# SESHAT_PORTAL_SYNC_MTLS=0
# SESHAT_PORTAL_TLS_CERT=/data/tls/portal.pem
# SESHAT_PORTAL_TLS_KEY=/data/tls/portal.key
# SESHAT_PORTAL_TLS_CLIENT_CA=/data/tls/senders-ca.pem
# Break-glass administrator, created on first start when the database has no users.
# SESHAT_PORTAL_ADMIN_EMAIL=
# SESHAT_PORTAL_ADMIN_PASSWORD=
# External base URL of either app; SSO redirect and logout addresses are built from it.
# SESHAT_PUBLIC_URL=https://tracker.example.com

# ---- Single sign-on, OpenID Connect (both apps; these override Settings > Sign-in) ----
# SESHAT_OIDC_ENABLED=true
# SESHAT_OIDC_PROVIDER_NAME=Example IdP
# SESHAT_OIDC_ISSUER=https://idp.example.com
# SESHAT_OIDC_CLIENT_ID=
# SESHAT_OIDC_CLIENT_SECRET=
# SESHAT_OIDC_SCOPES=openid profile email groups
# SESHAT_OIDC_GROUPS_CLAIM=groups
# SESHAT_OIDC_ADMIN_GROUPS=net-admins
# SESHAT_OIDC_OPERATOR_GROUPS=net-ops
# SESHAT_OIDC_USER_GROUPS=
# SESHAT_OIDC_DEFAULT_ROLE=user          # user | operator | deny
# SESHAT_OIDC_SCOPE_MAP=site-a-users=site:site-a;tenant-1-users=tenant:tenant-1
# SESHAT_OIDC_LOCAL_LOGIN=true           # false hides the password form; /login?local=1 stays open for local administrators
# ---- High availability (docs/ha.md) ----
# The cluster-wide part (VRRP instances, priorities, health policy) is configured in the UI under Cluster.
# This node's name; priorities in the configuration are keyed by it. Default: the hostname. Must be unique and stable.
# SESHAT_NODE_NAME=node-a
# Shared secret (16+ characters, identical on every node): authenticates the peer link and signs VRRP
# advertisements when an instance has "auth" on. SESHAT_SECRET_KEY must also be identical on every node.
# SESHAT_CLUSTER_SECRET=
# SQLite mode: the other nodes' API base URLs (comma separated) and this node's own, shown to the peers.
# Settings, SNMPv3 users and engine ID, flow templates and device records replicate over this link.
# SESHAT_CLUSTER_PEERS=http://192.0.2.12:8080
# SESHAT_CLUSTER_ADVERTISE=http://192.0.2.11:8080
# SESHAT_CLUSTER_SYNC_INTERVAL=5s
# Never run VRRP on this node, whatever the cluster configuration says.
# SESHAT_VRRP_DISABLE=0
# On stop: keep serving this long after releasing the virtual addresses, then wait up to the second
# duration for the output queues to empty. Give the service at least the sum plus 15 s to stop.
# SESHAT_DRAIN_GRACE=3s
# SESHAT_DRAIN_TIMEOUT=20s
# VRRP needs CAP_NET_ADMIN and CAP_NET_RAW and host networking: see deploy/compose/ha-pair.example.yaml.
# Never run the BGP anycast speaker (mode 3) on this node, whatever the cluster configuration says.
# The speaker itself (AS, neighbours, anycast addresses, withdraw rules) is configured in the UI under
# Cluster > BGP anycast; neighbour passwords are sealed with SESHAT_SECRET_KEY, which must therefore be
# identical on every node. Needs CAP_NET_ADMIN (not NET_RAW): see deploy/compose/ha-anycast.example.yaml.
# SESHAT_BGP_DISABLE=0
# ---- Edge collectors (docs/edge.md) ----
# On the MAIN server: a dedicated mutual-TLS listener for edge streams (empty = off). Edges can always also
# reach /api/edge/v1 on the main listener with their bearer token (use this behind a TLS-terminating proxy).
# SESHAT_EDGE_LISTEN=:8443
# Stream URL handed to edges at enrolment when it differs from the URL they enrolled through.
# SESHAT_EDGE_PUBLIC_URL=https://seshat.example.com:8443
# Names and addresses in the edge listener's certificate (the edge CA signs it), comma separated.
# SESHAT_EDGE_HOSTS=seshat.example.com,192.0.2.10
# Or use a public certificate for that listener instead of the edge CA's:
# SESHAT_EDGE_TLS_CERT=/data/tls/edge.pem
# SESHAT_EDGE_TLS_KEY=/data/tls/edge.key
# Refuse edge bearer tokens on every listener: edges must present their client certificate (needs SESHAT_EDGE_LISTEN).
# SESHAT_EDGE_REQUIRE_MTLS=0
# How long an edge bearer token stays valid (edges of this release rotate it long before). 0 = never.
# SESHAT_EDGE_TOKEN_MAX_AGE=400d
#
# On an EDGE box (SESHAT_ROLE=edge): no database, no secret key. The status page binds 127.0.0.1:8082 unless
# SESHAT_LISTEN says otherwise. First start can enrol from the environment (used once, then remove them):
# SESHAT_EDGE_SERVER=https://seshat.example.com
# SESHAT_EDGE_ENROL_TOKEN=sht_enr_...
# Or read it from a file (a mounted secret) so it never sits in the environment:
# SESHAT_EDGE_ENROL_TOKEN_FILE=/run/secrets/seshat-enrol-token
# PEM of the CA that signed the server's web certificate, when it is a private one:
# SESHAT_EDGE_CA_FILE=/data/server-ca.pem
# Evaluation only; logs a warning on every start. Also allows enrolling over plain http://.
# SESHAT_EDGE_INSECURE_SKIP_VERIFY=0
# ---- Kubernetes / external load balancer (docs/kubernetes.md, docs/ha.md Mode 4). The Helm chart sets these. ----
# Report "source_ip: snat_detected" on /api/ready, in the log and on the Dashboard when a datagram or connection
# arrives from one of these ranges (comma separated): the load balancer's SNAT pool and the cluster's node addresses.
# SESHAT_EXPECT_SOURCE_IP_PRESERVED=true
# SESHAT_LB_SNAT_CIDRS=198.51.100.0/24
# Singleton-job leader election: empty (follow the database), postgres, or k8s-lease (a coordination.k8s.io Lease,
# needs a service account allowed to get/create/update leases).
# SESHAT_LEADER_ELECTOR=
# SESHAT_LEASE_NAME=seshat-leader
# SESHAT_LEASE_NAMESPACE=
# Command line: `seshat store migrate` applies pending migrations and exits 0; `seshat --drain` makes the local
# instance not ready and waits for its queues to flush (the Kubernetes preStop hook).

# ---- Shared message bus between receive and deliver (docs/outputs.md "Shared message bus", docs/storage.md) ----
# Off by default: every replica delivers from its own disk queue under /data/queue, so a dead replica's backlog
# waits for that replica. With a bus, replicas publish per-destination batches to NATS JetStream or Kafka and
# EVERY replica delivers from it, for every destination.
#   nats://host:4222[,nats://host2:4222]   tls://host:4222   kafka://broker1:9092,broker2:9092[/prefix][?tls=1]
# SESHAT_QUEUE_BUS_URL=nats://bus.example.com:4222
# off | hybrid | only. hybrid (default when a URL is set): the local disk queue stays in front as a write-ahead buffer
# and a forwarder moves it to the bus; a bus outage never blocks intake and nothing is lost. only: publish directly,
# fall back to the local queue while the bus is unreachable; use it for stateless pods with an ephemeral /data.
# SESHAT_QUEUE_BUS_MODE=hybrid
# Stream/topic prefix (NATS stream "<prefix>_bus", Kafka topics "<prefix>.<destination>"). The kafka:// URL path overrides it.
# SESHAT_QUEUE_BUS_PREFIX=seshat
# Retention on the bus per stream/topic. A full NATS stream refuses new batches (the local queue keeps them).
# SESHAT_QUEUE_BUS_MAX_AGE=72h
# SESHAT_QUEUE_BUS_MAX_BYTES=0
# Concurrent consumers per destination per replica (0-32; more than 1 gives up ordering within a destination).
# Per destination: queue.bus_workers. On Kafka useful consumers are capped by the topic's partitions.
# SESHAT_QUEUE_BUS_PARALLELISM=1
# Largest message published (default 524288) and, for NATS, how long an unacknowledged batch is held for a consumer.
# SESHAT_QUEUE_BUS_MAX_BATCH_BYTES=524288
# SESHAT_QUEUE_BUS_ACK_WAIT=60s
# NATS stream replicas / Kafka replication factor, and Kafka partitions per topic (set when the topic is created).
# SESHAT_QUEUE_BUS_REPLICAS=1
# SESHAT_QUEUE_BUS_PARTITIONS=6
# Authentication: NATS creds file, token or user/password; Kafka SASL (plain, scram-sha-256, scram-sha-512).
# SESHAT_QUEUE_BUS_CREDS_FILE=/run/secrets/bus.creds
# SESHAT_QUEUE_BUS_TOKEN=
# SESHAT_QUEUE_BUS_USER=seshat
# SESHAT_QUEUE_BUS_PASSWORD=
# SESHAT_QUEUE_BUS_SASL=scram-sha-512
# TLS (PEM files). tls:// and kafka://...?tls=1 turn it on; a CA file or client certificate does too.
# SESHAT_QUEUE_BUS_TLS_CA_FILE=/run/secrets/bus-ca.pem
# SESHAT_QUEUE_BUS_TLS_CERT_FILE=/run/secrets/bus-client.pem
# SESHAT_QUEUE_BUS_TLS_KEY_FILE=/run/secrets/bus-client.key
# Set to 1 when /data does not survive a restart (stateless pods; set it by hand or from the Helm chart's persistence-off switch).
# With the bus mode off the process then logs an error at start and GET /api/queue lists the warning.
# SESHAT_DATA_EPHEMERAL=1

# ---- Go runtime ----
# The garbage collector reads these itself; Seshat does not change the defaults. A higher GOGC
# trades memory for throughput (GOGC=400: about 2.4x the RSS for about 15 % more syslog events/s on
# the reference host); pair it with a GOMEMLIMIT below the container's memory limit.
# GOGC=100
# GOMEMLIMIT=1536MiB
